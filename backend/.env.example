# Reference only: the backend reads process environment variables and does not
# load this file automatically. Export values before starting uvicorn.
# Defaults are shown. Uncomment and adjust only when needed.

# SOLFA_SCAN_DATA_DIR=C:\path\to\solfa-scan-data
SOLFA_SCAN_MAX_UPLOAD_MB=25
SOLFA_SCAN_MAX_PAGES=40
SOLFA_SCAN_MAX_IMAGE_SIDE=2600
SOLFA_SCAN_MIN_IMAGE_LONG_SIDE=1400
SOLFA_SCAN_PDF_DPI=220
SOLFA_SCAN_TTL_SECONDS=7200
SOLFA_SCAN_UNCERTAIN_THRESHOLD=0.72
SOLFA_OCR_LANG=en
SOLFA_OCR_SCORE_THRESHOLD=0.0
SOLFA_SCAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PP-OCRv6 + oneDNN crashes on some Windows CPUs. The adapter sets this to
# False unless it is explicitly overridden.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False
